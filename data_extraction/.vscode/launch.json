{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Uvicorn (Debug)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app:app",
                "--host", "0.0.0.0",
                "--port", "8000"
            ],
            "jinja": true,
            "console": "integratedTerminal"
        }
    ]
}
